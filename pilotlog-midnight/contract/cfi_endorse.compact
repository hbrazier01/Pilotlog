// PilotLog x Midnight: CFI passkey (WebAuthn ES256 / P-256) endorsement of logbook entries.
// ISOLATED / PREVIEW-TESTNET ONLY. See docs/design/cfi-passkey-signing.md.
//
// What lives on-chain (all public ledger state is hashes; no PII, no public keys):
//   admin        : commitment to the maintenance authority's secret (H(tag || sk))
//   cfiKeys      : keyId -> cfiRef     (keyId = SHA-256(P256 x || y); cfiRef = salted CFI pseudonym)
//   revokedAtSeq : keyId -> seq at which the key was revoked (endorsements with a lower seq stay valid)
//   endorsements : H(tag || entryHash || keyId) -> { entryHash, keyId, studentCommit, seq }
//   seq          : monotonically increasing counter, bumped on every endorsement and revocation
pragma language_version 0.28;

import CompactStandardLibrary;

export struct Endorsement {
  entryHash: Bytes<32>;
  keyId: Bytes<32>;
  studentCommit: Bytes<32>;
  seq: Uint<64>;
}

export ledger admin: Bytes<32>;
export ledger cfiKeys: Map<Bytes<32>, Bytes<32>>;
export ledger revokedAtSeq: Map<Bytes<32>, Uint<64>>;
export ledger endorsements: Map<Bytes<32>, Endorsement>;
export ledger seq: Counter;

// Maintenance authority secret, supplied from the caller's private state. Never disclosed.
witness adminSecret(): Bytes<32>;

constructor(adminCommit: Bytes<32>) {
  admin = disclose(adminCommit);
}

export pure circuit adminCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "pilotlog:cfi-admin:v1"), sk]);
}

circuit assertAdmin(): [] {
  assert(admin == adminCommitment(adminSecret()), "not the maintenance authority");
}

export pure circuit keyIdOf(pk: Secp256r1Point): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>]>(
      [secp256r1PointX(pk) as Bytes<32>, secp256r1PointY(pk) as Bytes<32>]);
}

// What the passkey signs (its WebAuthn challenge) for an endorsement. Binds deployment, entry and student.
export pure circuit endorseDigest(contractAddr: Bytes<32>, entryHash: Bytes<32>, studentCommit: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "pilotlog:cfi-endorse:v1"), contractAddr, entryHash, studentCommit]);
}

// What the passkey signs for a CFI self-revocation.
export pure circuit revokeDigest(contractAddr: Bytes<32>, keyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "pilotlog:cfi-revoke:v1"), contractAddr, keyId]);
}

export pure circuit endorsementKey(entryHash: Bytes<32>, keyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "pilotlog:cfi-endorsement:v1"), entryHash, keyId]);
}

// ---- WebAuthn verification (profile "std-v1": {"type":"webauthn.get","challenge":"…","origin":"<ORIGIN>","crossOrigin":false})

circuit b64urlIndex(c: Uint<8>): Field {
  if (c == 95) { return 63 as Field; }        // '_'
  if (c >= 97) {
    assert(c <= 122, "bad b64url char");
    return (c as Field) - 71;                 // 'a'..'z' -> 26..51
  } else if (c >= 65) {
    assert(c <= 90, "bad b64url char");
    return (c as Field) - 65;                 // 'A'..'Z' -> 0..25
  } else if (c >= 48) {
    assert(c <= 57, "bad b64url char");
    return (c as Field) + 4;                  // '0'..'9' -> 52..61
  } else {
    assert(c == 45, "bad b64url char");
    return 62 as Field;                       // '-'
  }
}

// `chal` (43 ASCII chars) must be the unpadded base64url encoding of `h`.
circuit assertChallengeIsB64url(h: Bytes<32>, chal: Bytes<43>): [] {
  const hb = h as Vector<32, Uint<8>>;
  const cb = chal as Vector<43, Uint<8>>;
  for (const g of 0..10) {
    const bytes = (hb[3*g] as Field) * 65536 + (hb[3*g+1] as Field) * 256 + (hb[3*g+2] as Field);
    const sixes = b64urlIndex(cb[4*g]) * 262144 + b64urlIndex(cb[4*g+1]) * 4096
                + b64urlIndex(cb[4*g+2]) * 64 + b64urlIndex(cb[4*g+3]);
    assert(bytes == sixes, "challenge != base64url(digest)");
  }
  const tail = (hb[30] as Field) * 1024 + (hb[31] as Field) * 4;
  const tailSixes = b64urlIndex(cb[40]) * 4096 + b64urlIndex(cb[41]) * 64 + b64urlIndex(cb[42]);
  assert(tail == tailSixes, "challenge != base64url(digest) (tail)");
}

// Verifies a passkey assertion over `digest` by `pk`. All inputs except the result stay private.
circuit verifyPasskey(
  digest: Bytes<32>, pk: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<74>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  assertChallengeIsB64url(digest, challenge);
  assert(cdSuffix == pad(74, "\",\"origin\":\"https://pilotlog.digitalaviationpool.com\",\"crossOrigin\":false}"),
         "unsupported clientDataJSON (origin/crossOrigin/profile)");
  const clientDataHash = persistentHash<[Bytes<36>, Bytes<43>, Bytes<74>]>(
      [pad(36, "{\"type\":\"webauthn.get\",\"challenge\":\""), challenge, cdSuffix]);
  const ad = authData as Vector<37, Uint<8>>;
  const rv = persistentHash<Bytes<32>>(pad(32, "pilotlog.digitalaviationpool.com")) as Vector<32, Uint<8>>;
  for (const i of 0..32) {
    assert(ad[i] == rv[i], "rpIdHash mismatch");
  }
  // flags = UP(1) + 2*bit1 + UV(4) + 8*high  => UP and UV both required
  assert((ad[32] as Field) == 1 + 2 * (flagsBit1 as Field) + 4 + 8 * (flagsHigh as Field),
         "authenticator flags must include UP and UV");
  assert(sig.r != default<Secp256r1Scalar>, "zero ECDSA r");
  assert(sig.s != default<Secp256r1Scalar>, "zero ECDSA s");
  const msgHash = persistentHash<[Bytes<37>, Bytes<32>]>([authData, clientDataHash]);
  assert(secp256r1EcdsaVerify(msgHash, sig, pk), "passkey signature invalid");
}

// ---- Registry administration (maintenance authority only)

export circuit enrollCfi(keyId: Bytes<32>, cfiRef: Bytes<32>): [] {
  assertAdmin();
  const k = disclose(keyId);
  assert(!revokedAtSeq.member(k), "revoked keys cannot be re-enrolled");
  assert(!cfiKeys.member(k), "key already enrolled");
  cfiKeys.insert(k, disclose(cfiRef));
}

export circuit revokeCfi(keyId: Bytes<32>): [] {
  assertAdmin();
  const k = disclose(keyId);
  assert(cfiKeys.member(k), "key not enrolled");
  assert(!revokedAtSeq.member(k), "key already revoked");
  revokedAtSeq.insert(k, seq.read());
  seq.increment(1);
}

export circuit rotateAdmin(newAdminCommit: Bytes<32>): [] {
  assertAdmin();
  admin = disclose(newAdminCommit);
}

// ---- CFI actions (proved with the CFI's passkey)

export circuit selfRevoke(
  cfiPubKey: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<74>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  const k = disclose(keyIdOf(cfiPubKey));
  verifyPasskey(revokeDigest(kernel.self().bytes, k), cfiPubKey, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  assert(cfiKeys.member(k), "key not enrolled");
  assert(!revokedAtSeq.member(k), "key already revoked");
  revokedAtSeq.insert(k, seq.read());
  seq.increment(1);
}

export circuit endorseEntry(
  entryHash: Bytes<32>, studentCommit: Bytes<32>,
  cfiPubKey: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<74>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  const e = disclose(entryHash);
  const sc = disclose(studentCommit);
  const k = disclose(keyIdOf(cfiPubKey));
  verifyPasskey(endorseDigest(kernel.self().bytes, e, sc), cfiPubKey, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  assert(cfiKeys.member(k), "CFI key not enrolled");
  assert(!revokedAtSeq.member(k), "CFI key revoked");
  // Dedupe on (entry, CFI), never on the signature: ECDSA (r, s) and (r, n-s) both verify.
  const ek = endorsementKey(e, k);
  assert(!endorsements.member(ek), "entry already endorsed by this CFI");
  endorsements.insert(ek, Endorsement { entryHash: e, keyId: k, studentCommit: sc, seq: seq.read() });
  seq.increment(1);
}
