// GENERATED by scripts/gen-contract.mjs from cfi_endorse.compact.in for staging (https://cfi-passkey-staging-staging.up.railway.app). Do not edit.
// PilotLog x Midnight: CFI passkey (WebAuthn ES256 / P-256) endorsement of logbook entries,
// with a layered registry:  ROOT (offline P-256 keys, Holland)  ->  SCHOOLS (admin passkey)  ->  CFIs (passkey).
// ISOLATED / PREVIEW-TESTNET ONLY. See docs/design/cfi-passkey-signing.md.
//
// GENERATED-SOURCE TEMPLATE. scripts/gen-contract.mjs substitutes the per-environment WebAuthn RP ID and
// origin (cfi-passkey-staging-staging.up.railway.app, 42, \",\"origin\":\"https://cfi-passkey-staging-staging.up.railway.app\",\"crossOrigin\":false}, 84) and writes contract/cfi_endorse.compact.
//
// Public ledger state is hashes only (no PII, no public keys):
//   rootKeys          : Set<keyId>                    active root keys (1-of-N; primary + backup)
//   retiredRootKeys   : Set<keyId>                    removed root keys; never re-addable (replay safety)
//   schools           : schoolId -> adminKeyId        active admin passkey of each school
//   adminKeySchool    : adminKeyId -> schoolId        reverse index; an admin key serves exactly one school
//   retiredAdminKeys  : Set<keyId>                    replaced admin keys; never re-usable (replay safety)
//   schoolRevokedAtSeq: schoolId -> seq               school revocations (onboarding the same id again is impossible)
//   cfiKeys           : keyId -> { cfiRef, schoolId } enrolled CFI passkeys; a key belongs to exactly one school
//   revokedAtSeq      : keyId -> seq                  CFI key revocations
//   endorsements      : H(tag || entryHash || keyId) -> { entryHash, keyId, schoolId, studentCommit, seq }
//   seq               : Counter bumped by every endorsement and every (CFI or school) revocation
//
// Endorsement validity for verifiers (revocation never deletes history):
//   valid(e) <=> cfiKeys[e.keyId].schoolId == e.schoolId
//             && (e.keyId    not in revokedAtSeq       || e.seq < revokedAtSeq[e.keyId])
//             && (e.schoolId not in schoolRevokedAtSeq || e.seq < schoolRevokedAtSeq[e.schoolId])
//
// Replay safety without nonces: every authorised operation is idempotent-or-impossible to repeat
// (enroll/onboard/add fail if already present; revoke/remove fail if already gone; replaced keys are
// retired forever), so a captured root or school signature can never be re-applied to a different state.
pragma language_version 0.28;

import CompactStandardLibrary;

export struct Endorsement {
  entryHash: Bytes<32>;
  keyId: Bytes<32>;
  schoolId: Bytes<32>;
  studentCommit: Bytes<32>;
  seq: Uint<64>;
}

export struct CfiRecord {
  cfiRef: Bytes<32>;
  schoolId: Bytes<32>;
}

export ledger rootKeys: Set<Bytes<32>>;
export ledger retiredRootKeys: Set<Bytes<32>>;
export ledger schools: Map<Bytes<32>, Bytes<32>>;
export ledger adminKeySchool: Map<Bytes<32>, Bytes<32>>;
export ledger retiredAdminKeys: Set<Bytes<32>>;
export ledger schoolRevokedAtSeq: Map<Bytes<32>, Uint<64>>;
export ledger cfiKeys: Map<Bytes<32>, CfiRecord>;
export ledger revokedAtSeq: Map<Bytes<32>, Uint<64>>;
export ledger endorsements: Map<Bytes<32>, Endorsement>;
export ledger seq: Counter;

constructor(rootKeyId: Bytes<32>) {
  rootKeys.insert(disclose(rootKeyId));
}

// ---- Pure helpers (mirrored byte-for-byte in src/canonical.mjs; tests assert equality)

export pure circuit keyIdOf(pk: Secp256r1Point): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>]>(
      [secp256r1PointX(pk) as Bytes<32>, secp256r1PointY(pk) as Bytes<32>]);
}

// What an offline ROOT key signs (raw ECDSA P-256 over SHA-256 of these 32 bytes) for root operation `op`.
export pure circuit rootDigest(contractAddr: Bytes<32>, op: Bytes<32>, a: Bytes<32>, b: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([pad(32, "pilotlog:cfi-root:v1"), contractAddr, op, a, b]);
}

// What a SCHOOL admin passkey signs (its WebAuthn challenge) for school operation `op`.
export pure circuit schoolDigest(contractAddr: Bytes<32>, op: Bytes<32>, schoolId: Bytes<32>, a: Bytes<32>, b: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<6, Bytes<32>>>([pad(32, "pilotlog:cfi-school:v1"), contractAddr, op, schoolId, a, b]);
}

// What a CFI passkey signs for an endorsement (the WebAuthn challenge). Binds deployment, entry, student and
// `attestHash` = SHA-256("pilotlog.attest.v1\n" || serverNonce(32) || signatureBlockCommit(32)), which carries the
// server-random, single-use challenge nonce (WebAuthn §13.4.3) and the AC 61-65K signature block / certification
// statement the CFI reviewed. attestHash is a PRIVATE circuit input: it never reaches the public ledger.
export pure circuit endorseDigest(contractAddr: Bytes<32>, entryHash: Bytes<32>, studentCommit: Bytes<32>, attestHash: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([pad(32, "pilotlog:cfi-endorse:v2"), contractAddr, entryHash, studentCommit, attestHash]);
}

// What a CFI passkey signs for a self-revocation.
export pure circuit revokeDigest(contractAddr: Bytes<32>, keyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "pilotlog:cfi-revoke:v1"), contractAddr, keyId]);
}

export pure circuit endorsementKey(entryHash: Bytes<32>, keyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "pilotlog:cfi-endorsement:v1"), entryHash, keyId]);
}

// ---- Signature checks

// ROOT: raw ECDSA P-256 (e.g. `openssl dgst -sha256 -sign`, YubiKey PIV, HSM) over SHA-256(digest).
circuit assertRoot(op: Bytes<32>, a: Bytes<32>, b: Bytes<32>, rootPk: Secp256r1Point, sig: Secp256r1EcdsaSignature): [] {
  assert(rootKeys.member(disclose(keyIdOf(rootPk))), "not a root key");
  assert(sig.r != default<Secp256r1Scalar>, "zero ECDSA r");
  assert(sig.s != default<Secp256r1Scalar>, "zero ECDSA s");
  const d = rootDigest(kernel.self().bytes, op, a, b);
  assert(secp256r1EcdsaVerify(persistentHash<Bytes<32>>(d), sig, rootPk), "root signature invalid");
}

// WebAuthn profile "std-v1": {"type":"webauthn.get","challenge":"…","origin":"<ORIGIN>","crossOrigin":false}
circuit b64urlIndex(c: Uint<8>): Field {
  if (c == 95) { return 63 as Field; }        // '_'
  if (c >= 97) {
    assert(c <= 122, "bad b64url char");
    return (c as Field) - 71;                 // 'a'..'z' -> 26..51
  } else if (c >= 65) {
    assert(c <= 90, "bad b64url char");
    return (c as Field) - 65;                 // 'A'..'Z' -> 0..25
  } else if (c >= 48) {
    assert(c <= 57, "bad b64url char");
    return (c as Field) + 4;                  // '0'..'9' -> 52..61
  } else {
    assert(c == 45, "bad b64url char");
    return 62 as Field;                       // '-'
  }
}

// `chal` (43 ASCII chars) must be the unpadded base64url encoding of `h`.
circuit assertChallengeIsB64url(h: Bytes<32>, chal: Bytes<43>): [] {
  const hb = h as Vector<32, Uint<8>>;
  const cb = chal as Vector<43, Uint<8>>;
  for (const g of 0..10) {
    const bytes = (hb[3*g] as Field) * 65536 + (hb[3*g+1] as Field) * 256 + (hb[3*g+2] as Field);
    const sixes = b64urlIndex(cb[4*g]) * 262144 + b64urlIndex(cb[4*g+1]) * 4096
                + b64urlIndex(cb[4*g+2]) * 64 + b64urlIndex(cb[4*g+3]);
    assert(bytes == sixes, "challenge != base64url(digest)");
  }
  const tail = (hb[30] as Field) * 1024 + (hb[31] as Field) * 4;
  const tailSixes = b64urlIndex(cb[40]) * 4096 + b64urlIndex(cb[41]) * 64 + b64urlIndex(cb[42]);
  assert(tail == tailSixes, "challenge != base64url(digest) (tail)");
}

// Verifies a passkey assertion over `digest` by `pk`. All inputs stay private.
circuit verifyPasskey(
  digest: Bytes<32>, pk: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  assertChallengeIsB64url(digest, challenge);
  assert(cdSuffix == pad(84, "\",\"origin\":\"https://cfi-passkey-staging-staging.up.railway.app\",\"crossOrigin\":false}"),
         "unsupported clientDataJSON (origin/crossOrigin/profile)");
  const clientDataHash = persistentHash<[Bytes<36>, Bytes<43>, Bytes<84>]>(
      [pad(36, "{\"type\":\"webauthn.get\",\"challenge\":\""), challenge, cdSuffix]);
  const ad = authData as Vector<37, Uint<8>>;
  const rv = persistentHash<Bytes<42>>(pad(42, "cfi-passkey-staging-staging.up.railway.app")) as Vector<32, Uint<8>>;
  for (const i of 0..32) {
    assert(ad[i] == rv[i], "rpIdHash mismatch");
  }
  // flags = UP(1) + 2*bit1 + UV(4) + 8*high  => UP and UV both required
  assert((ad[32] as Field) == 1 + 2 * (flagsBit1 as Field) + 4 + 8 * (flagsHigh as Field),
         "authenticator flags must include UP and UV");
  assert(sig.r != default<Secp256r1Scalar>, "zero ECDSA r");
  assert(sig.s != default<Secp256r1Scalar>, "zero ECDSA s");
  const msgHash = persistentHash<[Bytes<37>, Bytes<32>]>([authData, clientDataHash]);
  assert(secp256r1EcdsaVerify(msgHash, sig, pk), "passkey signature invalid");
}

// SCHOOL: the school's current admin passkey signed schoolDigest(op, schoolId, a, b); the school is active.
circuit assertSchoolAdmin(
  op: Bytes<32>, schoolId: Bytes<32>, a: Bytes<32>, b: Bytes<32>,
  adminPk: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  verifyPasskey(schoolDigest(kernel.self().bytes, op, schoolId, a, b), adminPk, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  const s = disclose(schoolId);
  assert(schools.member(s), "unknown school");
  assert(!schoolRevokedAtSeq.member(s), "school revoked");
  assert(schools.lookup(s) == disclose(keyIdOf(adminPk)), "not this school's admin");
}

// ---- ROOT operations (offline root key; rare)

export circuit rootOnboardSchool(schoolId: Bytes<32>, adminKeyId: Bytes<32>, rootPk: Secp256r1Point, sig: Secp256r1EcdsaSignature): [] {
  assertRoot(pad(32, "onboard-school"), schoolId, adminKeyId, rootPk, sig);
  const s = disclose(schoolId);
  const k = disclose(adminKeyId);
  assert(!schools.member(s), "school already onboarded");
  assert(!schoolRevokedAtSeq.member(s), "revoked school ids cannot be reused");
  assert(!adminKeySchool.member(k), "admin key already serves a school");
  assert(!retiredAdminKeys.member(k), "retired admin keys cannot be reused");
  schools.insert(s, k);
  adminKeySchool.insert(k, s);
}

export circuit rootRevokeSchool(schoolId: Bytes<32>, rootPk: Secp256r1Point, sig: Secp256r1EcdsaSignature): [] {
  assertRoot(pad(32, "revoke-school"), schoolId, default<Bytes<32>>, rootPk, sig);
  const s = disclose(schoolId);
  assert(schools.member(s), "unknown school");
  assert(!schoolRevokedAtSeq.member(s), "school already revoked");
  schoolRevokedAtSeq.insert(s, seq.read());
  seq.increment(1);
}

// Lost school-admin device: root replaces the school's admin key (the old one is retired forever).
export circuit rootSetSchoolAdmin(schoolId: Bytes<32>, newAdminKeyId: Bytes<32>, rootPk: Secp256r1Point, sig: Secp256r1EcdsaSignature): [] {
  assertRoot(pad(32, "set-school-admin"), schoolId, newAdminKeyId, rootPk, sig);
  const s = disclose(schoolId);
  const k = disclose(newAdminKeyId);
  assert(schools.member(s), "unknown school");
  assert(!schoolRevokedAtSeq.member(s), "school revoked");
  assert(!adminKeySchool.member(k), "admin key already serves a school");
  assert(!retiredAdminKeys.member(k), "retired admin keys cannot be reused");
  const old = schools.lookup(s);
  retiredAdminKeys.insert(old);
  adminKeySchool.remove(old);
  schools.insert(s, k);
  adminKeySchool.insert(k, s);
}

// Root key rotation / backup: add or remove a root key. Removing the signing key itself is allowed
// (backup removes a lost primary). Removed keys are retired forever; the last root key cannot be removed.
export circuit rootSetKey(keyId: Bytes<32>, active: Boolean, rootPk: Secp256r1Point, sig: Secp256r1EcdsaSignature): [] {
  // ONE signature check for both directions (two would double the ECDSA rows and push the circuit to k=18).
  const add = disclose(active);
  assertRoot(add ? pad(32, "add-root-key") : pad(32, "remove-root-key"), keyId, default<Bytes<32>>, rootPk, sig);
  const k = disclose(keyId);
  if (add) {
    assert(!rootKeys.member(k), "already a root key");
    assert(!retiredRootKeys.member(k), "retired root keys cannot be re-added");
    rootKeys.insert(k);
  } else {
    assert(rootKeys.member(k), "not a root key");
    assert(rootKeys.size() > 1, "cannot remove the last root key");
    rootKeys.remove(k);
    retiredRootKeys.insert(k);
  }
}

// ---- SCHOOL operations (school admin passkey; only on the school's own CFIs)

export circuit schoolEnrollCfi(
  schoolId: Bytes<32>, cfiKeyId: Bytes<32>, cfiRef: Bytes<32>,
  adminPk: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  assertSchoolAdmin(pad(32, "enroll-cfi"), schoolId, cfiKeyId, cfiRef, adminPk, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  const k = disclose(cfiKeyId);
  assert(!revokedAtSeq.member(k), "revoked keys cannot be re-enrolled");
  assert(!cfiKeys.member(k), "key already enrolled");
  cfiKeys.insert(k, CfiRecord { cfiRef: disclose(cfiRef), schoolId: disclose(schoolId) });
}

export circuit schoolRevokeCfi(
  schoolId: Bytes<32>, cfiKeyId: Bytes<32>,
  adminPk: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  assertSchoolAdmin(pad(32, "revoke-cfi"), schoolId, cfiKeyId, default<Bytes<32>>, adminPk, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  const k = disclose(cfiKeyId);
  assert(cfiKeys.member(k), "key not enrolled");
  assert(cfiKeys.lookup(k).schoolId == disclose(schoolId), "CFI belongs to another school");
  assert(!revokedAtSeq.member(k), "key already revoked");
  revokedAtSeq.insert(k, seq.read());
  seq.increment(1);
}

// School admin hands over to a new admin passkey (no root needed). The old key is retired forever.
export circuit schoolRotateAdmin(
  schoolId: Bytes<32>, newAdminKeyId: Bytes<32>,
  adminPk: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  assertSchoolAdmin(pad(32, "rotate-admin"), schoolId, newAdminKeyId, default<Bytes<32>>, adminPk, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  const s = disclose(schoolId);
  const k = disclose(newAdminKeyId);
  assert(!adminKeySchool.member(k), "admin key already serves a school");
  assert(!retiredAdminKeys.member(k), "retired admin keys cannot be reused");
  const old = schools.lookup(s);
  retiredAdminKeys.insert(old);
  adminKeySchool.remove(old);
  schools.insert(s, k);
  adminKeySchool.insert(k, s);
}

// ---- CFI actions (proved with the CFI's own passkey)

export circuit selfRevoke(
  cfiPubKey: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  const k = disclose(keyIdOf(cfiPubKey));
  verifyPasskey(revokeDigest(kernel.self().bytes, k), cfiPubKey, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  assert(cfiKeys.member(k), "key not enrolled");
  assert(!revokedAtSeq.member(k), "key already revoked");
  revokedAtSeq.insert(k, seq.read());
  seq.increment(1);
}

export circuit endorseEntry(
  entryHash: Bytes<32>, studentCommit: Bytes<32>, attestHash: Bytes<32>,
  cfiPubKey: Secp256r1Point, authData: Bytes<37>, challenge: Bytes<43>, cdSuffix: Bytes<84>,
  flagsBit1: Uint<1>, flagsHigh: Uint<5>, sig: Secp256r1EcdsaSignature
): [] {
  const e = disclose(entryHash);
  const sc = disclose(studentCommit);
  const k = disclose(keyIdOf(cfiPubKey));
  verifyPasskey(endorseDigest(kernel.self().bytes, e, sc, attestHash), cfiPubKey, authData, challenge, cdSuffix, flagsBit1, flagsHigh, sig);
  assert(cfiKeys.member(k), "CFI key not enrolled");
  assert(!revokedAtSeq.member(k), "CFI key revoked");
  const s = cfiKeys.lookup(k).schoolId;
  assert(!schoolRevokedAtSeq.member(s), "CFI's school revoked");
  // Dedupe on (entry, CFI), never on the signature: ECDSA (r, s) and (r, n-s) both verify.
  const ek = endorsementKey(e, k);
  assert(!endorsements.member(ek), "entry already endorsed by this CFI");
  endorsements.insert(ek, Endorsement { entryHash: e, keyId: k, schoolId: s, studentCommit: sc, seq: seq.read() });
  seq.increment(1);
}
