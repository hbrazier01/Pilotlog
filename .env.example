# Photoreal replay ground (optional). Cesium ion access token, read server-side only and never sent
# to the browser; tiles are proxied through /api/imagery. Free (Community) tier = non-commercial use.
# Without it the replay uses the stylized Terrarium terrain.
CESIUM_ION_TOKEN=

# ── Student accounts ─────────────────────────────────────────────────────────
# HMAC secret for the pl_session cookie (>= 32 random chars, e.g. `openssl rand -hex 32`).
# If unset, a per-process secret is used and everyone is signed out on every restart/redeploy.
SESSION_SECRET=
# One-time hand-off of the old single-user files (settings.json, checkride.json, tracks.json,
# entries.json) to one student. Set to the owner's canonical mn_addr_preprod1… address only when
# you want that migration; leave empty otherwise. Idempotent, never deletes the legacy files.
LEGACY_OWNER_WALLET=
# Wallets that can't sign messages (no signData) may sign in by address only when this is 1.
# That trusts the browser's claimed address (anyone could type it). Keep 0/empty in production.
ALLOW_UNVERIFIED_WALLET_LOGIN=
# Midnight network for sign-in addresses (default preprod).
MIDNIGHT_NETWORK=
# Monthly AI-coach cap per student in USD for the usage ledger (default 1).
COACH_MONTHLY_CAP_USD=
