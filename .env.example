# Photoreal replay ground (optional). Cesium ion access token, read server-side only and never sent
# to the browser; tiles are proxied through /api/imagery. Free (Community) tier = non-commercial use.
# Without it the replay uses the stylized Terrarium terrain.
CESIUM_ION_TOKEN=

# Accounts v2 (students + identities schema). Default OFF: when unset, startup migrations and all
# runtime behaviour are unchanged. When "true", startup also applies the additive accounts v2 DDL
# (students, identities, webauthn_credentials, auth_audit, nullable student_id columns). No route
# reads or writes these yet. See docs/accounts-v2.md before enabling anywhere real.
# PILOTLOG_ACCOUNTS_V2=false
# Accounts v2 sessions (only with PILOTLOG_ACCOUNTS_V2=true and DATABASE_URL). Defaults shown.
# PILOTLOG_COOKIE_SECURE=true            # set false ONLY for local http dev (cookie becomes pl_sid, no Secure)
# PILOTLOG_SESSION_ABSOLUTE_MS=2592000000 # 30 days
# PILOTLOG_SESSION_IDLE_MS=604800000      # 7 days
# PILOTLOG_ALLOWED_ORIGINS=               # extra allowed Origins for /api/v2 writes, comma-separated
# PILOTLOG_AUDIT_SALT=                    # optional salt for hashed audit subjects/IPs
# Accounts v2 email magic link (PR-3). Names only; never commit values.
# PILOTLOG_EMAIL_PROVIDER=                 # postmark | console | test (production: postmark only)
# POSTMARK_SERVER_TOKEN=                   # secret; set in Railway, never here
# PILOTLOG_EMAIL_FROM=                     # default support@digitalaviationpool.com
# PILOTLOG_PUBLIC_URL=                     # https base URL for links; required in production
# PILOTLOG_POST_LOGIN_PATH=                # default /cockpit
# PILOTLOG_MAGIC_LINK_TTL_MS=              # default 900000 (15 min)
# PILOTLOG_MAGIC_LINK_MAX_PER_EMAIL=       # default 3 per 15 min
# PILOTLOG_MAGIC_LINK_MAX_PER_IP=          # default 10 per 15 min
# Accounts v2 passkeys (PR-4). Names only; never commit values.
# PILOTLOG_RP_ID=                          # WebAuthn RP ID (registrable domain); required in production, default localhost in dev
# PILOTLOG_RP_NAME=                        # display name in the passkey prompt, default PilotLog
# (PILOTLOG_PUBLIC_URL above is also the WebAuthn expected origin; host must equal or be a subdomain of PILOTLOG_RP_ID)
# Accounts v2 wallets (PR-5). Names only.
# MIDNIGHT_NETWORK=                        # accepted mn_addr_<network>1 prefix, default preprod
# IE-4 paper logbook import (lean v1). Names only.
# PILOTLOG_PAPER_IMPORT=                   # true to enable /api/v2/import (also needs PILOTLOG_ACCOUNTS_V2)
# PILOTLOG_IMPORT_EXTRACTOR=               # manual (default) | fixture (non-production only). No model providers in v1.
# PILOTLOG_IMPORT_STORE=                   # local (default)
# PILOTLOG_IMPORT_DIR=                     # private directory for page images, default ./data/import-images
