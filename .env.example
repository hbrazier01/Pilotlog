# Photoreal replay ground (optional). Cesium ion access token, read server-side only and never sent
# to the browser; tiles are proxied through /api/imagery. Free (Community) tier = non-commercial use.
# Without it the replay uses the stylized Terrarium terrain.
CESIUM_ION_TOKEN=

# Accounts v2 (students + identities schema). Default OFF: when unset, startup migrations and all
# runtime behaviour are unchanged. When "true", startup also applies the additive accounts v2 DDL
# (students, identities, webauthn_credentials, auth_audit, nullable student_id columns). No route
# reads or writes these yet. See docs/accounts-v2.md before enabling anywhere real.
# PILOTLOG_ACCOUNTS_V2=false
# Accounts v2 sessions (only with PILOTLOG_ACCOUNTS_V2=true and DATABASE_URL). Defaults shown.
# PILOTLOG_COOKIE_SECURE=true            # set false ONLY for local http dev (cookie becomes pl_sid, no Secure)
# PILOTLOG_SESSION_ABSOLUTE_MS=2592000000 # 30 days
# PILOTLOG_SESSION_IDLE_MS=604800000      # 7 days
# PILOTLOG_ALLOWED_ORIGINS=               # extra allowed Origins for /api/v2 writes, comma-separated
# PILOTLOG_AUDIT_SALT=                    # optional salt for hashed audit subjects/IPs
